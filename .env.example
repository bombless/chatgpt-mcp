# Red Hat gateway
PORT=8787
PUBLIC_URL=https://bombless.duckdns.org
AGENT_TOKEN=replace-with-a-long-random-token
REQUEST_TIMEOUT_MS=60000
# Optional static MCP credential for clients that cannot complete OAuth (for
# example Gemini Spark). Generate a long random value and keep it secret.
# It is accepted as X-MCP-API-Key, X-API-Key, X-Goog-Api-Key,
# Authorization: ApiKey <value>, or Authorization: Bearer <value>.
MCP_API_KEY=
# Backward-compatible alias. Prefer MCP_API_KEY for new deployments.
MCP_TOKEN=
# Optional Base32 TOTP secret for OAuth approval. Leave empty when using only
# MCP_API_KEY. Protect this value like the JSON state file.
TOTP_SECRET=
ACCESS_TOKEN_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=2592000000

# Windows agent
SERVER_URL=wss://bombless.duckdns.org/agent
AGENT_ID=desktop-01
AGENT_TOKEN=replace-with-the-same-agent-token
ALLOWED_ROOTS=C:\Users\YourName\Documents,C:\Users\YourName\Desktop,D:\Projects
# Keep false until you explicitly want remote PowerShell execution.
ALLOW_COMMAND_EXECUTION=false
MAX_OUTPUT_BYTES=1000000

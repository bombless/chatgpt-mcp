# Red Hat gateway
PORT=8787
PUBLIC_URL=https://bombless.duckdns.org
AGENT_TOKEN=replace-with-a-long-random-token
REQUEST_TIMEOUT_MS=60000
# Optional legacy token for local testing only. Prefer OAuth for ChatGPT.
MCP_TOKEN=
ACCESS_TOKEN_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=2592000000
# Shared secret used only by GitHub Actions -> public update endpoint.
UPDATE_WEBHOOK_TOKEN=replace-with-an-independent-random-token
# Unix socket owned by the mcp-update supervisor.
UPDATE_SOCKET=/run/mcp-update.sock
UPDATE_BRANCH=main

# Windows agent
SERVER_URL=wss://bombless.duckdns.org/agent
AGENT_ID=desktop-01
AGENT_TOKEN=replace-with-the-same-agent-token
ALLOWED_ROOTS=C:\Users\YourName\Documents,C:\Users\YourName\Desktop,D:\Projects
# Keep false until you explicitly want remote PowerShell execution.
ALLOW_COMMAND_EXECUTION=false
MAX_OUTPUT_BYTES=1000000
